# Copy to .env.local for local development. All variables are optional.
# NEXT_PUBLIC_* values are embedded in the browser bundle: never put secrets in them.

# Overrides `url` in src/data/site.js (used for canonical links, the sitemap and preview images).
# Usually not needed. The GitHub Pages workflow sets it for you.
NEXT_PUBLIC_SITE_URL=

# Enables the contact form. Create a free form at https://formspree.io and paste its ID (the part after /f/).
NEXT_PUBLIC_FORMSPREE_FORM_ID=

# Only for hosting under a sub-path, e.g. https://<user>.github.io/<repo> -> /<repo>.
NEXT_PUBLIC_BASE_PATH=

# Visitor stats with Cloudflare Web Analytics (free, no cookies). Paste the token from the snippet Cloudflare gives you.
NEXT_PUBLIC_CLOUDFLARE_ANALYTICS_TOKEN=
